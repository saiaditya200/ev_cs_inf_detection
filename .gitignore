# ============================================================
# EV Charging Infrastructure Planning - .gitignore
# ============================================================

# Secrets
.env
*.env
.env.*
config/secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data (large files)
data/raw/*.json
data/raw/*.csv
data/raw/*.xlsx
!data/raw/.gitkeep

# Model outputs
models/*.pkl
models/*.joblib
models/*.h5

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# Redundant nested folder
EV_Charging/

# Intermediate architecture image crops
reports/figures/crop_*.png
reports/figures/paper_crops/
